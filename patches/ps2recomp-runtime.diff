+// PMFHL reads the 128-bit HI/LO pair: (hi, lo) are bits 0-63 and (hi1, lo1) bits 64-127.
+// Word i of LO is lo.w0, lo.w1, lo1.w0, lo1.w1 (the same for HI).
+inline uint32_t ps2_word_of(uint64_t low, uint64_t high, int index)
+{
+    const uint64_t half = index < 2 ? low : high;
+    return static_cast<uint32_t>((index & 1) ? (half >> 32) : half);
+}
+
+inline int32_t ps2_saturate_s32(int64_t value)
+{
+    return value > INT32_MAX ? INT32_MAX : (value < INT32_MIN ? INT32_MIN : static_cast<int32_t>(value));
+}
+
+inline int16_t ps2_saturate_s16(int32_t value)
+{
+    return value > INT16_MAX ? INT16_MAX : (value < INT16_MIN ? INT16_MIN : static_cast<int16_t>(value));
+}
+
+// PMFHL.LW: rd.w = { LO.w0, HI.w0, LO.w2, HI.w2 }
+inline __m128i ps2_pmfhl_lw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi32(static_cast<int>(ps2_word_of(hi, hi1, 2)), static_cast<int>(ps2_word_of(lo, lo1, 2)),
+                         static_cast<int>(ps2_word_of(hi, hi1, 0)), static_cast<int>(ps2_word_of(lo, lo1, 0)));
+}
+
+// PMFHL.UW: rd.w = { LO.w1, HI.w1, LO.w3, HI.w3 }
+inline __m128i ps2_pmfhl_uw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    return _mm_set_epi32(static_cast<int>(ps2_word_of(hi, hi1, 3)), static_cast<int>(ps2_word_of(lo, lo1, 3)),
+                         static_cast<int>(ps2_word_of(hi, hi1, 1)), static_cast<int>(ps2_word_of(lo, lo1, 1)));
+}
+
+// PMFHL.SLW: rd.d = { sat32(HI.w0:LO.w0), sat32(HI.w2:LO.w2) }, sign-extended to 64 bits
+inline __m128i ps2_pmfhl_slw(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    const int64_t d0 = static_cast<int64_t>((static_cast<uint64_t>(ps2_word_of(hi, hi1, 0)) << 32) | ps2_word_of(lo, lo1, 0));
+    const int64_t d1 = static_cast<int64_t>((static_cast<uint64_t>(ps2_word_of(hi, hi1, 2)) << 32) | ps2_word_of(lo, lo1, 2));
+    return _mm_set_epi64x(ps2_saturate_s32(d1), ps2_saturate_s32(d0));
+}
+
+// PMFHL.LH: rd.h = { LO.h0, LO.h2, HI.h0, HI.h2, LO.h4, LO.h6, HI.h4, HI.h6 } (the low halfword of each word)
+inline __m128i ps2_pmfhl_lh(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    auto h = [&](uint64_t a, uint64_t b, int word) { return static_cast<short>(ps2_word_of(a, b, word) & 0xFFFFu); };
+    return _mm_set_epi16(h(hi, hi1, 3), h(hi, hi1, 2), h(lo, lo1, 3), h(lo, lo1, 2),
+                         h(hi, hi1, 1), h(hi, hi1, 0), h(lo, lo1, 1), h(lo, lo1, 0));
+}
+
+// PMFHL.SH: rd.h = sat16 of { LO.w0, LO.w1, HI.w0, HI.w1, LO.w2, LO.w3, HI.w2, HI.w3 }
+inline __m128i ps2_pmfhl_sh(uint64_t hi, uint64_t lo, uint64_t hi1, uint64_t lo1)
+{
+    auto s = [&](uint64_t a, uint64_t b, int word) { return ps2_saturate_s16(static_cast<int32_t>(ps2_word_of(a, b, word))); };
+    return _mm_set_epi16(s(hi, hi1, 3), s(hi, hi1, 2), s(lo, lo1, 3), s(lo, lo1, 2),
+                         s(hi, hi1, 1), s(hi, hi1, 0), s(lo, lo1, 1), s(lo, lo1, 0));
+}
+
+// The generated code calls these as PS2_PMFHL_xx(ctx->hi, ctx->lo); ctx is in scope there.
+#define PS2_PMFHL_LW(hi, lo) ps2_pmfhl_lw((hi), (lo), ctx->hi1, ctx->lo1)
+#define PS2_PMFHL_UW(hi, lo) ps2_pmfhl_uw((hi), (lo), ctx->hi1, ctx->lo1)
+#define PS2_PMFHL_SLW(hi, lo) ps2_pmfhl_slw((hi), (lo), ctx->hi1, ctx->lo1)
+#define PS2_PMFHL_LH(hi, lo) ps2_pmfhl_lh((hi), (lo), ctx->hi1, ctx->lo1)
+#define PS2_PMFHL_SH(hi, lo) ps2_pmfhl_sh((hi), (lo), ctx->hi1, ctx->lo1)
 
