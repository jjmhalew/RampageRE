+bool PS2IopHostAdapter::hasEeRpcServer(uint32_t sid) const
+{
+    std::lock_guard<std::mutex> lock(g_rpc_mutex);
+    const auto it = g_rpc_servers.find(sid);
+    return it != g_rpc_servers.end() && it->second.sd_ptr != 0u;
+}
+
+// IOP -> EE RPC: the EE server function runs as a scheduler invocation; its return value points at the
+// reply, of which the IOP caller gets `receiveSize` bytes.
+bool PS2IopHostAdapter::callEeRpc(uint32_t sid,
+                                  uint32_t function,
+                                  std::vector<uint8_t> send,
+                                  uint32_t receiveSize,
+                                  std::function<void(const std::vector<uint8_t> &)> done)
+{
+    RpcServerState server{};
+    {
+        std::lock_guard<std::mutex> lock(g_rpc_mutex);
+        const auto it = g_rpc_servers.find(sid);
+        if (it == g_rpc_servers.end() || it->second.sd_ptr == 0u)
+            return false;
+        server = it->second;
+    }
+
+    uint8_t *rdram = m_runtime.memory().getRDRAM();
+    auto *sd = reinterpret_cast<t_SifRpcServerData *>(getMemPtr(rdram, server.sd_ptr));
+    if (!sd || !m_runtime.hasFunction(sd->func))
+        return false;
+    if (sd->buf != 0u && !send.empty())
+    {
+        if (uint8_t *destination = getMemPtr(rdram, sd->buf))
+            std::memcpy(destination, send.data(), send.size());
+    }
+    sd->rpc_number = static_cast<int>(function);
+    sd->size = static_cast<int>(send.size());
+
+    GuestInvocation invocation{};
+    invocation.kind = GuestInvocationKind::RpcCallback;
+    invocation.context.pc = sd->func;
+    SET_GPR_U32(&invocation.context, 4, function);
+    SET_GPR_U32(&invocation.context, 5, sd->buf);
+    SET_GPR_U32(&invocation.context, 6, static_cast<uint32_t>(send.size()));
+    SET_GPR_U32(&invocation.context, 28, server.gp);
+    SET_GPR_U32(&invocation.context, 29, 0u); // the scheduler supplies the invocation stack
+    SET_GPR_U32(&invocation.context, 31, 0u);
+    invocation.onComplete = [this, receiveSize, done = std::move(done)](const R5900Context &completed, R5900Context &)
+    {
+        std::vector<uint8_t> reply;
+        const uint32_t result = getRegU32(&completed, 2);
+        if (receiveSize != 0u && result != 0u)
+        {
+            if (const uint8_t *source = getConstMemPtr(m_runtime.memory().getRDRAM(), result))
+                reply.assign(source, source + receiveSize);
+        }
+        done(reply);
+    };
+    m_runtime.eeScheduler().queueInvocation(std::move(invocation));
+    return true;
+}
