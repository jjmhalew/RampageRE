+void PS2Memory::drainVif1Mfifo()
+{
+    static constexpr uint32_t VIF1_CHANNEL = 0x10009000u;
+    static constexpr uint32_t D_STAT = 0x1000E010u;
+    if (!m_vif1MfifoRunning || !isVif1Mfifo())
+        return;
+
+    uint32_t chcr = m_ioRegisters[VIF1_CHANNEL];
+    if ((chcr & 0x100u) == 0u)
+    {
+        m_vif1MfifoRunning = false;
+        return;
+    }
+
+    const uint32_t rbor = m_ioRegisters[0x1000E050u] & 0x7FFFFFF0u;
+    const uint32_t rbsr = m_ioRegisters[0x1000E040u] & 0x7FFFFFF0u;
+    auto wrap = [&](uint32_t addr)
+    { return rbor | (addr & rbsr); };
+
+    const uint32_t writeAddr = wrap(m_ioRegisters[0x1000D010u]); // fromSPR MADR: end of written data
+    uint32_t tadr = wrap(m_ioRegisters[VIF1_CHANNEL + 0x30u]);
+    const bool transferTag = (chcr & 0x40u) != 0u; // CHCR.TTE
+    const bool tieEnabled = (chcr & 0x80u) != 0u;  // CHCR.TIE
+    std::vector<uint8_t> chainData;
+    uint32_t lastTagUpper = (chcr >> 16u) & 0xFFFFu;
+    bool ended = false;
+
+    auto appendQwords = [&](uint32_t addr, uint32_t count, bool inRing)
+    {
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            const uint32_t a = inRing ? wrap(addr + i * 16u) : addr + i * 16u;
+            if (isScratchpad(a))
+            {
+                const uint32_t off = a & (PS2_SCRATCHPAD_SIZE - 16u);
+                chainData.insert(chainData.end(), m_scratchpad + off, m_scratchpad + off + 16u);
+                continue;
+            }
+            const uint32_t phys = translateAddress(a);
+            if (phys + 16u > PS2_RAM_SIZE)
+                break;
+            chainData.insert(chainData.end(), m_rdram + phys, m_rdram + phys + 16u);
+        }
+    };
+
+    for (int guard = 0; guard < 65536 && tadr != writeAddr; ++guard)
+    {
+        const uint32_t available = (writeAddr - tadr) & rbsr; // written but not yet drained
+        const uint32_t tagPhys = translateAddress(tadr);
+        if (tagPhys + 16u > PS2_RAM_SIZE)
+            break;
+        const uint64_t tag = loadScalar<uint64_t>(m_rdram + tagPhys, 0, 16, "mfifo dma tag", tadr);
+        const uint32_t qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t id = static_cast<uint32_t>((tag >> 28) & 0x7u);
+        const bool irq = ((tag >> 31) & 0x1ull) != 0ull;
+        const uint32_t addr = static_cast<uint32_t>((tag >> 32) & 0xFFFFFFF0u);
+
+        const bool payloadInRing = (id == 1u || id == 2u || id == 7u); // cnt, next, end
+        if (payloadInRing && 16u + qwc * 16u > available)
+            break; // stall until fromSPR has written the whole packet
+
+        if (transferTag)
+            chainData.insert(chainData.end(), m_rdram + tagPhys + 8u, m_rdram + tagPhys + 16u);
+        lastTagUpper = static_cast<uint32_t>((tag >> 16) & 0xFFFFu);
+
+        switch (id)
+        {
+        case 0: // refe
+            appendQwords(addr, qwc, false);
+            tadr = wrap(tadr + 16u);
+            ended = true;
+            break;
+        case 1: // cnt
+            appendQwords(tadr + 16u, qwc, true);
+            tadr = wrap(tadr + 16u + qwc * 16u);
+            break;
+        case 2: // next
+            appendQwords(tadr + 16u, qwc, true);
+            tadr = wrap(addr);
+            break;
+        case 3: // ref
+        case 4: // refs
+            appendQwords(addr, qwc, false);
+            tadr = wrap(tadr + 16u);
+            break;
+        case 7: // end
+            appendQwords(tadr + 16u, qwc, true);
+            tadr = wrap(tadr + 16u + qwc * 16u);
+            ended = true;
+            break;
+        default: // call/ret are not valid in MFIFO mode
