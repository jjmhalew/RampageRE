     }
+
+    namespace
+    {
+        struct DirEntry
+        {
+            std::string name;
+            bool directory = false;
+            uint64_t size = 0;
+        };
+
+        struct OpenDirectory
+        {
+            std::vector<DirEntry> entries;
+            size_t next = 0;
+        };
+
+        std::mutex g_dirMutex;
+        std::unordered_map<int32_t, OpenDirectory> g_openDirs;
+        int32_t g_nextDirDescriptor = 0x400;
+
+        bool isCdPath(std::string_view path)
+        {
+            return path.size() >= 5 && (path.substr(0, 5) == "cdrom" || path.substr(0, 5) == "CDROM");
+        }
+    }
+
+    // sceDopen(path): lists a host directory. cdrom0: paths get CD conventions (upper case, ";1" on files).
+    void fioDopen(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const char *ps2Path = reinterpret_cast<const char *>(getConstMemPtr(rdram, getRegU32(ctx, 4)));
+        std::filesystem::path hostPath;
+        std::error_code ec;
+        if (!ps2Path || !runtime->vfs().resolveHostPath(ps2Path, currentVfsMounts(), hostPath) ||
+            !std::filesystem::is_directory(hostPath, ec))
+        {
+            setReturnS32(ctx, -1);
+            return;
+        }
+
+        const bool cd = isCdPath(ps2Path);
+        OpenDirectory dir;
+        dir.entries.push_back({".", true, 0});
+        dir.entries.push_back({"..", true, 0});
+        std::vector<DirEntry> found;
+        for (const auto &item : std::filesystem::directory_iterator(hostPath, ec))
+        {
+            DirEntry entry;
+            entry.name = item.path().filename().string();
+            entry.directory = item.is_directory(ec);
+            entry.size = entry.directory ? 0 : item.file_size(ec);
+            if (cd)
+            {
+                std::transform(entry.name.begin(), entry.name.end(), entry.name.begin(),
+                               [](unsigned char c) { return static_cast<char>(std::toupper(c)); });
+                if (!entry.directory)
+                    entry.name += ";1";
+            }
+            found.push_back(std::move(entry));
+        }
+        std::sort(found.begin(), found.end(), [](const DirEntry &a, const DirEntry &b) { return a.name < b.name; });
+        dir.entries.insert(dir.entries.end(), found.begin(), found.end());
+
+        std::lock_guard<std::mutex> lock(g_dirMutex);
+        const int32_t descriptor = g_nextDirDescriptor++;
+        g_openDirs[descriptor] = std::move(dir);
+        setReturnS32(ctx, descriptor);
+    }
+
+    // sceDread(fd, sce_dirent*): sce_stat (64 bytes) followed by name[256]; returns 1 per entry, 0 at the end.
+    void fioDread(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)runtime;
+        const int32_t descriptor = static_cast<int32_t>(getRegU32(ctx, 4));
+        uint8_t *out = getMemPtr(rdram, getRegU32(ctx, 5));
+        std::lock_guard<std::mutex> lock(g_dirMutex);
+        const auto it = g_openDirs.find(descriptor);
+        if (it == g_openDirs.end() || !out)
+        {
+            setReturnS32(ctx, -1);
+            return;
+        }
+        if (it->second.next >= it->second.entries.size())
+        {
+            setReturnS32(ctx, 0);
+            return;
+        }
+
+        const DirEntry &entry = it->second.entries[it->second.next++];
+        std::memset(out, 0, 64 + 256);
+        const uint32_t mode = entry.directory ? 0x116Du : 0x2124u; // iomanX FDIR / FREG with read access
+        const uint32_t size = static_cast<uint32_t>(entry.size);
+        const uint32_t hisize = static_cast<uint32_t>(entry.size >> 32);
+        std::memcpy(out + 0, &mode, 4);
+        std::memcpy(out + 8, &size, 4);
+        std::memcpy(out + 36, &hisize, 4);
+        std::memcpy(out + 64, entry.name.data(), std::min<size_t>(255, entry.name.size()));
+        setReturnS32(ctx, 1);
+    }
+
+    void fioDclose(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        std::lock_guard<std::mutex> lock(g_dirMutex);
+        setReturnS32(ctx, g_openDirs.erase(static_cast<int32_t>(getRegU32(ctx, 4))) != 0 ? 0 : -1);
+    }
 }
