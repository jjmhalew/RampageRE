+        PendingTransfer pt;
+        pt.fromScratchpad = false;
+        pt.srcAddr = 0;
+        pt.qwc = 0;
+        pt.chainData = std::move(chainData);
+        m_pendingVif1Transfers.push_back(std::move(pt));
+        processPendingTransfers(); // keeps VIF1 running while m_vif1MfifoRunning is set
+    }
+
+    if (ended)
+    {
+        m_vif1MfifoRunning = false;
+        completeDmacChannel(VIF1_CHANNEL, 1u);
+    }
+    else if (tadr == writeAddr)
+    {
+        m_ioRegisters[D_STAT] |= 1u << 14u; // MEIS: MFIFO empty
+    }
